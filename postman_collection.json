{
  "info": {
    "name": "Universal Search & Filter API",
    "_postman_id": "universal-search-api-v4",
    "description": "Universal Search + Filter API for databases.\n\n### Setup\n1. Start the server: `npm start` (defaults to `http://localhost:3100`).\n2. Run `01 · Discovery & schema → List all discovered databases` first.\n3. The collection is safe to run with Postman Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Discovery & schema",
      "item": [
        {
          "name": "List all discovered databases — RUN THIS FIRST",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/databases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "databases"]
            },
            "description": "Discovers all accessible databases. Captures `databaseId` automatically."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('has databases array', () => {",
                  "  pm.expect(data).to.have.property('databases');",
                  "  pm.expect(data.databases).to.be.an('array');",
                  "  if (data.databases.length > 0) {",
                  "    pm.collectionVariables.set('databaseId', data.databases[0].id);",
                  "    pm.collectionVariables.set('databaseTitle', data.databases[0].title);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Force refresh discovery cache",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/databases?refresh=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "databases"],
              "query": [{ "key": "refresh", "value": "1" }]
            },
            "description": "Re-queries discovery cache."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter instructions by database ID (/api/filter-instructions/:id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/filter-instructions/{{databaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "filter-instructions", "{{databaseId}}"]
            },
            "description": "Returns simple, self-describing search capability and instruction document for AI agents."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('has database, how_to_search, and filters', () => {",
                  "  pm.expect(data).to.have.property('database');",
                  "  pm.expect(data).to.have.property('how_to_search');",
                  "  pm.expect(data).to.have.property('filters');",
                  "  for (const [key, val] of Object.entries(data.filters || {})) {",
                  "    if (key.toLowerCase() === 'priority' && val.accepted_values) {",
                  "      pm.collectionVariables.set('priorityName', val.accepted_values[0]);",
                  "    }",
                  "    if (key.toLowerCase() === 'status' && val.accepted_values) {",
                  "      pm.collectionVariables.set('statusName', val.accepted_values[0]);",
                  "    }",
                  "    if (key.toLowerCase() === 'epic' && val.accepted_values) {",
                  "      pm.collectionVariables.set('relationName', val.accepted_values[0]);",
                  "    }",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dropdown options and values",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/options?database_id={{databaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "options"],
              "query": [{ "key": "database_id", "value": "{{databaseId}}" }]
            },
            "description": "Values formatted for frontend dropdowns."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Liveness probe."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 · POST Search (searchText across all fields)",
      "item": [
        {
          "name": "All items — no filter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"pageSize\": 25\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Returns records for the database."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('has results and total', () => {",
                  "  pm.expect(d).to.have.property('results');",
                  "  pm.expect(d).to.have.property('total');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Free text search across all fields",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"searchText\": \"access\",\n  \"pageSize\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Case-insensitive search across all text fields, page body, and comments."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Free text search — checklist term",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"searchText\": \"checklist\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Searches for checklist across all fields."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 · POST Search with structured filter",
      "item": [
        {
          "name": "Filter by single select option",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"filter\": {\n    \"Priority\": \"{{priorityName}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Filters by select option."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter with multi-value array (OR-ed)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"filter\": {\n    \"Priority\": [\"P0\", \"P1\"]\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Array of values in a filter field is OR-ed."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by Status",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"filter\": {\n    \"Status\": \"{{statusName}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Filters by status name."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by Relation title",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"filter\": {\n    \"Epic\": \"{{relationName}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Filters by related item title."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Combined searchText + filter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"searchText\": \"access\",\n  \"filter\": {\n    \"Status\": \"{{statusName}}\",\n    \"Priority\": \"{{priorityName}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Combines free text searchText and property filters."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 · Pagination",
      "item": [
        {
          "name": "Page 1 — five per page",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"pageSize\": 5,\n  \"offset\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Captures `nextOffset` for next page."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "if (d.next_cursor) pm.collectionVariables.set('nextOffset', d.next_cursor);"
                ]
              }
            }
          ]
        },
        {
          "name": "Page 2 — offset pagination",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"databaseId\": \"{{databaseId}}\",\n  \"pageSize\": 5,\n  \"offset\": {{nextOffset}}\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fetches page 2 using offset."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {

    {
      "name": "06 · Edge cases",
      "item": [
        {
          "name": "Unknown field names in fields parameter are ignored",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/search?database_id={{databaseId}}&q=test&fields=bogus_field,story,title",
              "host": ["{{baseUrl}}"],
              "path": ["api", "search"],
              "query": [
                { "key": "database_id", "value": "{{databaseId}}" },
                { "key": "q", "value": "test" },
                { "key": "fields", "value": "bogus_field,story,title" }
              ]
            },
            "description": "Unrecognized fields are ignored; valid ones apply."
          },
          "response": [],
          "event": [
            {

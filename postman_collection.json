{
  "info": {
    "name": "Notion Universal Search & Filter — Generic Database Discovery",
    "_postman_id": "notion-universal-search-v2",
    "description": "Universal Search + Filter API for any Notion database in your workspace.\n\n### Setup\n1. Start the server: `npm start` (defaults to `http://localhost:3100`).\n2. Run `01 · Database discovery & metadata → List all discovered databases` first. Its test script automatically captures `{{databaseId}}`, `{{databaseTitle}}`, and properties.\n3. The collection is safe to run with Postman's Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 · Database discovery & metadata",
      "item": [
        {
          "name": "List all discovered databases — RUN THIS FIRST",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/databases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "databases"]
            },
            "description": "Discovers all Notion databases accessible to the integration token. Captures `databaseId` automatically."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('has databases array', () => {",
                  "  pm.expect(data).to.have.property('databases');",
                  "  pm.expect(data.databases).to.be.an('array');",
                  "  if (data.databases.length > 0) {",
                  "    pm.collectionVariables.set('databaseId', data.databases[0].id);",
                  "    pm.collectionVariables.set('databaseTitle', data.databases[0].title);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Force refresh database discovery cache",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/databases?refresh=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "databases"],
              "query": [{ "key": "refresh", "value": "1" }]
            },
            "description": "Re-queries Notion search API immediately rather than serving from the 5-minute cache."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Database schema & filter capabilities (by ID)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/databases/{{databaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "databases", "{{databaseId}}"]
            },
            "description": "Returns full schema, properties, filter operators, and value choices for the specified database."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('has database and filters', () => {",
                  "  pm.expect(data).to.have.property('database');",
                  "  pm.expect(data).to.have.property('filters');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter instructions capability document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/filters?database_id={{databaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "filters"],
              "query": [{ "key": "database_id", "value": "{{databaseId}}" }]
            },
            "description": "Self-describing capability document with parameters, allowed values, Notion templates, and cURL examples."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('has filters array', () => {",
                  "  pm.expect(data.filters).to.be.an('array');",
                  "  const priorityFilter = data.filters.find(f => f.notion_type === 'select' || f.parameter.toLowerCase() === 'priority');",
                  "  if (priorityFilter && priorityFilter.values && priorityFilter.values[0]) {",
                  "    pm.collectionVariables.set('priorityName', priorityFilter.values[0].name || priorityFilter.values[0].label);",
                  "  }",
                  "  const statusFilter = data.filters.find(f => f.notion_type === 'status' || f.parameter.toLowerCase() === 'status');",
                  "  if (statusFilter && statusFilter.values && statusFilter.values[0]) {",
                  "    pm.collectionVariables.set('statusName', statusFilter.values[0].name || statusFilter.values[0].label);",
                  "  }",
                  "  const relationFilter = data.filters.find(f => f.notion_type === 'relation');",
                  "  if (relationFilter && relationFilter.values && relationFilter.values[0]) {",
                  "    pm.collectionVariables.set('relationName', relationFilter.values[0].title || relationFilter.values[0].label);",
                  "    pm.collectionVariables.set('relationId', relationFilter.values[0].id);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter instructions by database ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/filter-instructions/{{databaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "filter-instructions", "{{databaseId}}"]
            },
            "description": "Returns filter capability and instruction document for the specified database ID in the path."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('has database and filters', () => {",
                  "  pm.expect(data).to.have.property('database');",
                  "  pm.expect(data).to.have.property('filters');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dropdown options and values",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/options?database_id={{databaseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "options"],
              "query": [{ "key": "database_id", "value": "{{databaseId}}" }]
            },
            "description": "Values formatted for frontend dropdowns."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has properties and options', () => {",
                  "  const d = pm.response.json();",
                  "  pm.expect(d).to.have.property('properties');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Liveness probe. Returns `{ ok: true }`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
